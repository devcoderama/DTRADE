# ============================================================
#  binance-ai-future — contoh konfigurasi
#  Salin file ini menjadi ".env" lalu isi nilainya.
#  JANGAN PERNAH meng-commit file .env ke Git.
# ============================================================

# --- Binance USDⓈ-M Futures API ------------------------------
# Buat di Binance: Profil → API Management → Create API (System generated).
# Wajib: aktifkan filter "Restrict access to trusted IPs only",
# centang "Enable Futures", JANGAN centang "Enable Withdrawals".
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true  = pakai testnet (https://testnet.binancefuture.com) — dana virtual.
# false = mainnet, dana sungguhan.
BINANCE_TESTNET=false

# --- AI Router BangunWeb --------------------------------------
# Ambil kunci (bentuk: bwr_live_...) dari dasbor AI Router BangunWeb.
# Dokumentasi: https://bangunweb.com/ai/docs
BANGUNWEB_API_KEY=
BANGUNWEB_BASE_URL=https://router.bangunweb.com/v1
# Mode model: bw-swift (cepat/murah) | bw-focus (analisa, bawaan) |
#             bw-pro (logika rumit)   | bw-apex (paling kuat)
BANGUNWEB_MODEL=bw-focus

# --- Mode & Keselamatan Trading --------------------------------
# dry_run = semua order hanya disimulasikan (BAWAAN, paling aman).
# live    = order sungguhan dikirim ke Binance.
TRADING_MODE=dry_run

# --- Manajemen Risiko -------------------------------------------
RISK_PER_TRADE_PCT=1.0        # % saldo yang dirisikokan per posisi
MAX_LEVERAGE=5                # batas leverage maksimum yang diizinkan
MAX_OPEN_POSITIONS=3          # jumlah posisi terbuka maksimum
DAILY_LOSS_LIMIT_PCT=3.0      # berhenti trading hari ini bila rugi harian >= %
DEFAULT_INTERVAL=15m          # interval candle bawaan untuk analisis
QUOTE_ASSET=USDT              # hanya simbol perpetual berpasangan ini yang dipindai

# --- Web UI -------------------------------------------------------
WEB_HOST=0.0.0.0              # 0.0.0.0 = bisa diakses dari ponsel di Wi-Fi yang sama
WEB_PORT=8000
