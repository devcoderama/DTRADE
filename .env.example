# ============================================================
#  binance-ai-future — contoh konfigurasi
#  Salin file ini menjadi ".env" lalu isi nilainya.
#  JANGAN PERNAH meng-commit file .env ke Git.
# ============================================================

# --- Binance USDⓈ-M Futures API ------------------------------
# Buat di Binance: Profil → API Management → Create API (System generated).
# Wajib: aktifkan filter "Restrict access to trusted IPs only",
# centang "Enable Futures", JANGAN centang "Enable Withdrawals".
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true  = pakai testnet (https://testnet.binancefuture.com) — dana virtual.
# false = mainnet, dana sungguhan.
BINANCE_TESTNET=false

# --- AI Router BangunWeb --------------------------------------
# Ambil kunci (bentuk: bwr_live_...) dari dasbor AI Router BangunWeb.
# Dokumentasi: https://bangunweb.com/ai/docs
BANGUNWEB_API_KEY=
BANGUNWEB_BASE_URL=https://router.bangunweb.com/v1
# Mode model: bw-swift (cepat/murah) | bw-focus (analisa, bawaan) |
#             bw-pro (logika rumit)   | bw-apex (paling kuat)
BANGUNWEB_MODEL=bw-focus

# --- Provider AI Lainnya (opsional) ------------------------------
# Pilih provider aktif dengan AI_PROVIDER:
#   bangunweb (bawaan) | openai | anthropic | deepseek | grok | nous | custom
# Cukup isi kunci provider yang Anda pakai; yang lain boleh kosong.
# CATATAN: AI_PROVIDER dan model-model di berkas ini hanyalah NILAI AWAL.
# Provider + model bisa diganti kapan pun TANPA mengedit berkas ini —
# lewat panel "Provider & Model AI" di Web UI atau perintah CLI
# `python run.py cli ai-model --provider ... --model ...` — dan pilihan
# itu tersimpan otomatis di data/ai_settings.json (berlaku langsung).
AI_PROVIDER=bangunweb

# Hasil analisis AI di-cache selama ini (detik) agar sinyal di Web UI,
# siaran Telegram, CLI, dan tombol eksekusi konsisten untuk momen yang
# sama (dan hemat token). 0 = nonaktif.
ANALYSIS_CACHE_TTL_SEC=180

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Grok dari xAI (XAI_API_KEY; GROK_API_KEY juga diterima)
XAI_API_KEY=
XAI_MODEL=grok-4

# Nous Portal — kunci dari https://portal.nousresearch.com
NOUS_API_KEY=
NOUS_MODEL=Hermes-4-70B

# Gateway OpenAI-compatible lain (mis. OpenRouter / server sendiri)
AI_CUSTOM_BASE_URL=
AI_CUSTOM_API_KEY=
AI_CUSTOM_MODEL=

# --- Notifikasi Telegram ------------------------------------------
# Buat bot lewat @BotFather, lalu isi tokennya di sini.
# TELEGRAM_CHAT_ID: user id Anda (dari @userinfobot) untuk pesan pribadi,
# atau id channel/grup (biasanya diawali -100) — tambahkan bot sebagai
# admin bila memakai channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS=true

# --- Siaran sinyal otomatis ke Telegram (aktif selama `python run.py web`) ---
# Server web otomatis memindai semua simbol secara berkala, mengonfirmasi
# kandidat terkuat dengan AI, dan mengirim yang lolos ke Telegram sebagai
# foto grafik + caption. Butuh TELEGRAM_BOT_TOKEN & TELEGRAM_CHAT_ID di atas.
BROADCAST_ENABLED=true
BROADCAST_INTERVAL_MINUTES=30
BROADCAST_MIN_SCORE=50
BROADCAST_MAX_SIGNALS=3
BROADCAST_COOLDOWN_HOURS=4

# --- Mode & Keselamatan Trading --------------------------------
# dry_run = semua order hanya disimulasikan (BAWAAN, paling aman).
# live    = order sungguhan dikirim ke Binance.
TRADING_MODE=dry_run

# --- Manajemen Risiko -------------------------------------------
RISK_PER_TRADE_PCT=1.0        # % saldo yang dirisikokan per posisi
MAX_LEVERAGE=5                # batas leverage maksimum yang diizinkan
MAX_OPEN_POSITIONS=3          # jumlah posisi terbuka maksimum
DAILY_LOSS_LIMIT_PCT=3.0      # kunci harian persisten bila PnL ekuitas hari ini <= -% ini
WEEKLY_LOSS_LIMIT_PCT=6.0     # berhenti bila PnL ekuitas minggu ini <= -% ini
MIN_RISK_REWARD=1.5           # rasio TP:SL minimum agar sinyal diterima RiskManager
MAX_SYMBOL_EXPOSURE_PCT=150   # notional satu simbol maksimum (% dari ekuitas)
MAX_TOTAL_EXPOSURE_PCT=300    # total notional semua posisi maksimum (% dari ekuitas)
MAX_CONSECUTIVE_LOSSES=3      # berhenti setelah N realisasi rugi beruntun (0 = nonaktif)
PROTECTION_RETRIES=3          # percobaan pasang SL/TP sebelum emergency close
DEFAULT_INTERVAL=15m          # interval candle bawaan untuk analisis
QUOTE_ASSET=USDT              # hanya simbol perpetual berpasangan ini yang dipindai
MTF_ENABLED=true              # sertakan konteks multi-timeframe (1H/4H/1D) pada analisis

# --- Keamanan Web UI / API ----------------------------------------
# PENTING: bila server dapat dijangkau perangkat/orang lain (WEB_HOST=0.0.0.0
# di jaringan bersama, VPS, port-forward), WAJIB isi WEB_API_TOKEN.
# Tanpa token, siapa pun yang membuka alamat server dapat mengeksekusi
# trade dari akun Anda. Web UI akan meminta token ini sekali dan
# mengingatnya di peramban yang sama.
WEB_API_TOKEN=
# Token tambahan khusus baca-saja (hanya GET) — aman dibagikan untuk memantau.
WEB_VIEWER_TOKEN=
# Origin CORS yang diizinkan (pisah koma). Kosong = hanya same-origin.
# Jangan pernah memakai "*" bersamaan dengan token.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=240     # batas request /api per IP per menit (0 = nonaktif)
MARKET_WS_ENABLED=true        # WebSocket data pasar real-time untuk grafik Web UI

# --- Database (Supabase / PostgreSQL) — OPSIONAL ----------------------
# Bila diisi, jurnal perdagangan & peristiwa eksekusi juga dicerminkan ke
# database (tabel trade_journal & execution_events dibuat otomatis).
# JSONL lokal tetap menjadi sumber utama; kegagalan DB tidak mengganggu
# trading. Ambil dari Dashboard Supabase → Project Settings → Database →
# Connection string. String ini berisi PASSWORD database — perlakukan
# seperti secret: hanya di .env server Anda, jangan dibagikan/commit.
DATABASE_URL=

# --- Web UI -------------------------------------------------------
WEB_HOST=0.0.0.0              # 0.0.0.0 = bisa diakses dari ponsel di Wi-Fi yang sama
WEB_PORT=8000
