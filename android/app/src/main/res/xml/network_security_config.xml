<?xml version="1.0" encoding="utf-8"?>
<!-- Kebijakan jaringan D TRADE (diperketat):
     - Bawaan: HTTPS wajib, cleartext (HTTP) DITOLAK.
     - Cleartext hanya diizinkan untuk pengembangan lokal: localhost dan
       emulator host 10.0.2.2.
     - Android TIDAK mendukung rentang CIDR privat (192.168.0.0/16 dsb.)
       di domain-config. Bila backend Anda berjalan di IP LAN tertentu,
       tambahkan SATU entri domain-config dengan IP persis itu (lihat
       android/README.md), atau — lebih aman — akses backend lewat
       Tailscale/HTTPS dan tidak perlu cleartext sama sekali.
     - CATATAN v1.13.1: pin-set SSL yang sempat ditambahkan di v1.13.0
       DICABUT. Pin diturunkan dari data Certificate Transparency, tetapi
       edge regional yang melayani pengguna ternyata menyajikan rantai
       CA perantara yang berbeda, sehingga aplikasi menolak koneksi
       Binance/Yahoo ("Pin verification failed"). Pinning hanya boleh
       diaktifkan lagi setelah rantai asli teramati dari jaringan
       pengguna sendiri. Seluruh pengerasan lain v1.13.0 (cakupan
       jembatan, validasi redirect, blokir HTTP publik, setelan WebView)
       tetap berlaku. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
