<?xml version="1.0" encoding="utf-8"?>
<!-- Backend binance-ai-future biasanya berjalan di jaringan lokal (IP LAN)
     atau VPS tanpa HTTPS, jadi lalu lintas HTTP (cleartext) diizinkan agar
     Web UI dapat dimuat. Bila server Anda memakai HTTPS, konfigurasi ini
     tidak berpengaruh. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
